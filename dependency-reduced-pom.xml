<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.acabes</groupId>
  <artifactId>five250</artifactId>
  <version>1.3.1</version>
  <build>
    <finalName>five250</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>com.acabes.five250.Cli</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>build-self-contained-dist</id>
            <phase>verify</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <fail>
                  <condition>
                    <not>
                      <available />
                    </not>
                  </condition>
                </fail>
                <delete />
                <mkdir />
                <exec>
                  <arg />
                  <arg />
                  <arg />
                  <arg />
                  <arg />
                  <arg />
                  <arg />
                  <arg />
                  <arg />
                  <arg />
                </exec>
                <condition>
                  <available />
                </condition>
                <copy />
                <copy />
                <copy />
                <copy />
                <copy />
                <chmod />
                <chmod />
                <echo>Self-contained distribution built at ${project.build.directory}/dist (from ${dist.source.jar}) - zip that folder and copy it to any machine of this same OS/architecture; no Java install required there.</echo>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>obfuscate</id>
                <phase>package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <fail>
                      <condition>
                        <not>
                          <available />
                        </not>
                      </condition>
                    </fail>
                    <delete />
                    <java>
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                    </java>
                    <echo>Obfuscated jar built at ${project.build.directory}/five250-release-obfuscated.jar</echo>
                  </target>
                </configuration>
              </execution>
            </executions>
            <dependencies>
              <dependency>
                <groupId>com.guardsquare</groupId>
                <artifactId>proguard-base</artifactId>
                <version>7.7.0</version>
              </dependency>
            </dependencies>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
  <dependencies>
    <dependency>
      <groupId>org.graalvm.polyglot</groupId>
      <artifactId>js</artifactId>
      <version>24.1.1</version>
      <type>pom</type>
      <scope>compile</scope>
      <exclusions>
        <exclusion>
          <artifactId>js</artifactId>
          <groupId>org.graalvm.js</groupId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>
  <properties>
    <maven.compiler.target>17</maven.compiler.target>
    <maven.compiler.source>17</maven.compiler.source>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
</project>
